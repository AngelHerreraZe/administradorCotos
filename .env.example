# ═════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE ENTORNO: ADMINISTRADOR DE COTOS
# REGLA DE SEGURIDAD: NUNCA commitear credenciales reales al repositorio.
# ═════════════════════════════════════════════════════════════════

# --- APLICACIÓN Y MULTI-TENANCY ---
NODE_ENV=development
LOG_LEVEL=info
# --- API (apps/api) ---
PORT=4000
# Orígenes exactos del frontend, separados por coma (nunca *)
CORS_ORIGINS=http://localhost:3000
# Publica /openapi.json (desactivar en producción salvo API de partners)
API_DOCS=true
# --- WORKER (apps/worker) ---
# Colas que procesa ESTA instancia; cada despliegue recibe solo los secretos de sus colas
WORKER_QUEUES=auditoria
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_DOMAIN=admcotos.local
COOKIE_SECRET=generar_con_openssl_rand_hex_32_caracteres_minimo

# --- BASE DE DATOS (POSTGRESQL + PGBOUNCER) ---
# Cada proceso recibe SOLO la URL de su rol. Nunca dos en el mismo entorno.
# Producción: agrega ?sslmode=verify-full (y NODE_EXTRA_CA_CERTS si el proveedor usa CA propia).
# API (rol app_service, RLS aplica). La API aborta al arrancar si el rol puede saltarse RLS.
# PgBouncer ≥ 1.21 en modo transaction: NO agregues pgbouncer=true (Prisma 7 + adapter pg)
DATABASE_URL=postgresql://app_service:password@localhost:5432/administradorcotos
# Solo CI / `prisma migrate deploy` (dueño de las tablas). NO debe existir en el runtime de la API ni de workers.
DIRECT_DATABASE_URL=postgresql://postgres:admin_password@localhost:5432/administradorcotos
# Solo workers (rol app_worker, multi-tenant: cobros, webhooks, timbrado, auditoría). Nunca en la API.
WORKER_DATABASE_URL=postgresql://app_worker:password@localhost:5432/administradorcotos
# Firma del contexto RLS (hex, 32 bytes). El MISMO valor va en app_private.ctx_secret:
#   INSERT INTO app_private.ctx_secret (secret) VALUES (decode('<este valor>', 'hex'));
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_CTX_SECRET=

# --- REDIS (CACHE, COLAS BULLMQ, RATE LIMITING) ---
REDIS_PASSWORD=
# Node --env-file no expande variables: repite aquí la misma contraseña que REDIS_PASSWORD
REDIS_URL=redis://:cambia-esta-contraseña@localhost:6379
# En producción (Upstash Serverless):
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# --- CRIPTOGRAFÍA (AES-256-GCM, llave por organización vía HKDF) ---
# "<versión>:<base64 de 32 bytes>" separadas por coma; la versión más alta cifra.
# Rotar = agregar "2:..." y re-cifrar en segundo plano; nunca borrar una versión con datos vivos.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEKS=1:
# Solo el worker de auditoría. La llave HMAC nunca va a la API ni a la BD.
AUDIT_LOG_HMAC_SECRET=

# --- AUTENTICACIÓN (SUPABASE AUTH) ---
# Supabase se usa SOLO para Auth. La Data API (PostgREST) no debe exponer el esquema public:
# la migración de seguridad revoca anon/authenticated sobre tablas de negocio.
# Verifica los JWT con las llaves asimétricas del proyecto (JWKS), no con un secreto compartido.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role salta RLS: solo back-office/workers, jamás en la API pública ni en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- PASARELA DE PAGOS (CONEKTA - MÉXICO) ---
CONEKTA_API_KEY=key_test_tuClavePrivadaConekta
CONEKTA_PUBLIC_KEY=key_publica_para_frontend_tokenizacion
CONEKTA_API_VERSION=application/vnd.conekta-v2.3.0+json
# Llave pública RSA de Conekta para verificar la firma del header 'digest' en Webhooks
CONEKTA_WEBHOOK_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- FACTURACIÓN FISCAL SAT (CFDI 4.0 / PAC) ---
PAC_PROVIDER=finkok # o solucionfactible, diverza
PAC_USERNAME=usuario_pac_pruebas
PAC_PASSWORD=password_pac_pruebas
PAC_TEST_MODE=true

# --- WHATSAPP GATEWAY SELF-HOSTED (EVOLUTION API V2 - ANTI-BAN) ---
EVOLUTION_SERVER_URL=http://localhost:8080
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVOLUTION_MASTER_API_KEY=
EVOLUTION_DATABASE_URI=postgresql://postgres:admin_password@localhost:5432/evolution_db?schema=public
# Proxy Residencial México (Telmex / Totalplay) para aislamiento de IP de WhatsApp
RESIDENTIAL_PROXY_HOST=pr.oxylabs.io # o brightdata, iproyal
RESIDENTIAL_PROXY_PORT=7777
RESIDENTIAL_PROXY_USER=usuario_proxy_mx
RESIDENTIAL_PROXY_PASSWORD=password_proxy_mx

# --- WHATSAPP CLOUD API OFICIAL (META BUSINESS - SEGUNDO RIEL BROADCAST) ---
META_WHATSAPP_TOKEN=EAAB...
META_WHATSAPP_PHONE_NUMBER_ID=1092837465...
META_WHATSAPP_BUSINESS_ACCOUNT_ID=987654321...
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=token_aleatorio_para_handshake_con_meta

# --- INTELIGENCIA ARTIFICIAL & OCR (GOOGLE GEMINI) ---
GEMINI_API_KEY=AIzaSy...

# --- CORREO TRANSACCIONAL (RESEND) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Administrador de Cotos <notificaciones@admcotos.mx>"

# --- INFRAESTRUCTURA Y MARCA BLANCA (CLOUDFLARE FOR SAAS) ---
CLOUDFLARE_API_TOKEN=cf_token_con_permisos_custom_hostnames
CLOUDFLARE_ZONE_ID=zone_id_del_dominio_raiz
CLOUDFLARE_CNAME_TARGET=cname.admcotos.mx
