// ══════════════════════════════════════════════════════════════════════
// PRISMA SCHEMA: ADMINISTRADOR DE COTOS (MULTI-TENANT ENTERPRISE)
// ──────────────────────────────────────────────────────────────────────
// Lo que Prisma no puede expresar (RLS, CHECKs, triggers de integridad,
// exclusión de horarios, funciones de consulta) vive en
// prisma/migrations/*_seguridad_rls/migration.sql. Al generar migraciones
// nuevas con `prisma migrate dev --create-only`, revisa que no intenten
// borrar objetos de esa migración.
// ══════════════════════════════════════════════════════════════════════

// Prisma 7: cliente TypeScript ESM generado dentro del paquete (src/generated, ignorado por git).
// importFileExtension "ts" permite ejecutarlo con el type stripping nativo de Node 26, sin build.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

// Las URLs viven en prisma.config.ts (CLI) y en src/client.ts (runtime).
// Extensiones (pgcrypto, uuid-ossp, citext, btree_gist): las crea la migración init.
datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────────────
// NIVEL 0: PLATAFORMA
// ──────────────────────────────────────────────────────────────────────

/// Personal de soporte de la plataforma. Solo ve datos de una organización
/// mientras exista un SoporteAcceso vigente otorgado por su org_owner.
model StaffPlataforma {
  usuarioId String   @id @map("usuario_id") @db.Uuid
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("staff_plataforma")
}

/// Ventana de soporte consentida (máx. 72 h, solo lectura).
model SoporteAcceso {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  otorgadoPor String       @map("otorgado_por") @db.Uuid
  ticketRef   String       @map("ticket_ref") @db.VarChar(50)
  desde       DateTime     @default(now()) @db.Timestamptz
  hasta       DateTime     @db.Timestamptz
  revocadoEn  DateTime?    @map("revocado_en") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organizacion Organizacion @relation(fields: [orgId], references: [id])
  otorgante    Usuario      @relation(fields: [otorgadoPor], references: [id])

  @@index([orgId, hasta])
  @@map("soporte_accesos")
}

/// Idempotencia de webhooks (Conekta, Stripe, Meta, Evolution).
/// La API solo puede INSERTAR (createMany + skipDuplicates); el worker procesa.
model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proveedor   String    @db.VarChar(20)
  eventId     String    @map("event_id") @db.VarChar(200)
  tipo        String    @db.VarChar(100)
  payload     Json
  recibidoEn  DateTime  @default(now()) @map("recibido_en") @db.Timestamptz
  procesadoEn DateTime? @map("procesado_en") @db.Timestamptz
  intentos    Int       @default(0) @db.SmallInt
  error       String?

  @@unique([proveedor, eventId])
  @@index([procesadoEn, recibidoEn])
  @@map("webhook_events")
}

// ──────────────────────────────────────────────────────────────────────
// NIVEL 1: ORGANIZACIÓN (MAYORISTA / DESPACHO / PARTNER)
// ──────────────────────────────────────────────────────────────────────

model Organizacion {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String       @db.VarChar(200)
  slug             String       @unique @db.VarChar(100)
  rfc              String?      @db.VarChar(13)
  razonSocial      String?      @map("razon_social") @db.VarChar(300)
  emailContacto    String       @map("email_contacto") @db.Citext
  telefono         String?      @db.VarChar(20)

  // Marca Blanca y Custom Domains
  customDomain     String?      @unique @map("custom_domain") @db.VarChar(255)
  logoUrl          String?      @map("logo_url")
  colorPrimario    String?      @default("#1E40AF") @map("color_primario") @db.VarChar(7)
  colorSecundario  String?      @default("#3B82F6") @map("color_secundario") @db.VarChar(7)
  faviconUrl       String?      @map("favicon_url")

  // Billing B2B Wholesale (solo el worker/back-office los modifica)
  stripeCustomerId String?      @map("stripe_customer_id") @db.VarChar(100)
  tierMayoreo      String       @default("tier_1") @map("tier_mayoreo") @db.VarChar(20) // tier_1, tier_2, tier_3, enterprise
  walletCreditos   Decimal      @default(0.00) @map("wallet_creditos") @db.Decimal(12, 2)
  autoRecarga      Boolean      @default(false) @map("auto_recarga")
  montoRecargaMin  Decimal      @default(2000.00) @map("monto_recarga_min") @db.Decimal(12, 2)
  estadoSuscripcion String      @default("activo") @map("estado_suscripcion") @db.VarChar(20) // activo, solo_lectura, suspendido

  // LFPDPPP
  avisoPrivacidadUrl String?    @map("aviso_privacidad_url")
  avisoVersion       Int        @default(1) @map("aviso_version")

  // Relaciones
  cotos            Coto[]
  miembrosOrg      OrgMiembro[]
  paquetesTimbres  PaqueteTimbres[]
  apiKeys          PartnerApiKey[]
  soporteAccesos   SoporteAcceso[]

  activo           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("organizaciones")
}

model OrgMiembro {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  usuarioId      String       @map("usuario_id") @db.Uuid
  rol            String       @db.VarChar(20) // org_owner, org_admin
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organizacion   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([orgId, usuarioId])
  @@index([usuarioId, activo])
  @@map("org_miembros")
}

model PartnerApiKey {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  nombre         String       @db.VarChar(100)
  keyPrefix      String       @map("key_prefix") @db.VarChar(16) // ej. "ac_live_7f8a"
  keyHash        String       @unique @map("key_hash") @db.Char(64) // SHA-256 del secret
  scopes         String[]     @default(["read"])
  ipWhitelist    String[]     @default([]) @map("ip_whitelist")
  ultimoUso      DateTime?    @map("ultimo_uso") @db.Timestamptz
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organizacion   Organizacion @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("partner_api_keys")
}

// ──────────────────────────────────────────────────────────────────────
// NIVEL 2: COTO / CONDOMINIO GESTIONADO
// ──────────────────────────────────────────────────────────────────────

model Coto {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String        @map("org_id") @db.Uuid
  nombre                String        @db.VarChar(200)
  slug                  String        @db.VarChar(100)
  zonaHoraria           String        @default("America/Mexico_City") @map("zona_horaria") @db.VarChar(50)

  // Ubicación
  direccion             String?
  colonia               String?       @db.VarChar(200)
  ciudad                String?       @db.VarChar(100)
  estado                String?       @db.VarChar(100)
  cp                    String?       @db.VarChar(5)
  latitud               Decimal?      @db.Decimal(10, 8)
  longitud              Decimal?      @db.Decimal(11, 8)

  // Configuración Legal y Operativa
  tipo                  String        @default("coto") @db.VarChar(30)
  regimenLegal          String?       @map("regimen_legal") @db.VarChar(50)
  diaCorte              Int           @default(1) @map("dia_corte") @db.SmallInt
  diaLimitePago         Int           @default(10) @map("dia_limite_pago") @db.SmallInt
  tasaMoratoria         Decimal       @default(0.00) @map("tasa_moratoria") @db.Decimal(5, 2)
  tipoMoratoria         String        @default("ninguno") @map("tipo_moratoria") @db.VarChar(10)
  descuentoProntoPago   Decimal       @default(0.00) @map("descuento_pronto_pago") @db.Decimal(5, 2)
  diasGracia            Int           @default(0) @map("dias_gracia") @db.SmallInt

  // Reglas de Convivencia y Seguridad
  bloquearAmenidadesMorosos Boolean   @default(true) @map("bloquear_amenidades_morosos")
  mesesMorosidadBloqueo     Int       @default(2) @map("meses_morosidad_bloqueo") @db.SmallInt

  // Datos fiscales públicos (el CSD vive aparte en CotoSecreto)
  rfcCoto               String?       @map("rfc_coto") @db.VarChar(13)
  razonSocialCoto       String?       @map("razon_social_coto") @db.VarChar(300)
  regimenFiscal         String?       @map("regimen_fiscal") @db.VarChar(5)
  cpFiscal              String?       @map("cp_fiscal") @db.VarChar(5)

  // Relaciones
  organizacion          Organizacion  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  secreto               CotoSecreto?
  sectores              Sector[]
  unidades              Unidad[]
  miembrosCoto          MiembroCoto[]
  conceptosCargo        ConceptoCargo[]
  cargos                Cargo[]
  pagos                 Pago[]
  detallePagos          DetallePago[]
  paymentMethods        PaymentMethod[]
  cuentasBancarias      CuentaBancaria[]
  egresos               Egreso[]
  proveedores           Proveedor[]
  facturasCfdi          FacturaCfdi[]
  amenidades            Amenidad[]
  reservaciones         Reservacion[]
  comunicados           Comunicado[]
  tickets               Ticket[]
  ticketComentarios     TicketComentario[]
  votaciones            Votacion[]
  opcionesVoto          OpcionVoto[]
  votos                 Voto[]
  invitaciones          InvitacionAcceso[]
  registrosAcceso       RegistroAcceso[]
  dispositivosIot       DispositivoIot[]
  autopayConfigs        AutopayConfig[]
  autopayIntentos       AutopayIntento[]

  activo                Boolean       @default(true)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([orgId, slug])
  @@index([orgId, activo])
  @@map("cotos")
}

/// CSD del SAT cifrado (AES-256-GCM, llave por organización, AAD = fila).
/// La API no tiene ningún privilegio sobre esta tabla: escribe vía
/// app.guardar_csd() y solo el worker de timbrado la lee.
model CotoSecreto {
  cotoId      String   @id @map("coto_id") @db.Uuid
  csdCert     Bytes    @map("csd_cert")
  csdKey      Bytes    @map("csd_key")
  csdPassword Bytes    @map("csd_password")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coto        Coto     @relation(fields: [cotoId], references: [id], onDelete: Cascade)

  @@map("coto_secretos")
}

// ──────────────────────────────────────────────────────────────────────
// NIVEL 3: UNIDADES Y HABITANTES
// ──────────────────────────────────────────────────────────────────────

model Sector {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId    String   @map("coto_id") @db.Uuid
  nombre    String   @db.VarChar(100)
  tipo      String   @default("seccion") @db.VarChar(30)
  orden     Int      @default(0) @db.SmallInt
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  coto      Coto     @relation(fields: [cotoId], references: [id], onDelete: Cascade)
  unidades  Unidad[]

  @@unique([cotoId, nombre])
  @@map("sectores")
}

model Unidad {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId         String           @map("coto_id") @db.Uuid
  sectorId       String?          @map("sector_id") @db.Uuid
  numero         String           @db.VarChar(20)
  tipo           String           @default("casa") @db.VarChar(30)
  superficieM2   Decimal?         @map("superficie_m2") @db.Decimal(10, 2)
  indiviso       Decimal?         @db.Decimal(8, 6) // fracción 0..1
  saldoAFavor    Decimal          @default(0.00) @map("saldo_a_favor") @db.Decimal(12, 2)
  ocupada        Boolean          @default(true)
  activo         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coto           Coto             @relation(fields: [cotoId], references: [id], onDelete: Cascade)
  sector         Sector?          @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  miembros       MiembroCoto[]
  cargos         Cargo[]
  pagos          Pago[]
  paymentMethods PaymentMethod[]
  autopayConfig  AutopayConfig?
  invitaciones   InvitacionAcceso[]
  reservaciones  Reservacion[]
  tickets        Ticket[]
  votos          Voto[]
  registrosAcceso RegistroAcceso[]

  @@unique([cotoId, numero])
  @@index([cotoId, activo, ocupada])
  @@map("unidades")
}

model Usuario {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId                 String           @unique @map("auth_id") @db.Uuid
  nombre                 String           @db.VarChar(100)
  apellidoPaterno        String           @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno        String?          @map("apellido_materno") @db.VarChar(100)
  email                  String           @unique @db.Citext
  telefono               String?          @db.VarChar(20)
  telefonoVerificado     Boolean          @default(false) @map("telefono_verificado")
  mfaActivo              Boolean          @default(false) @map("mfa_activo")
  aceptoAvisoPrivacidad  Boolean          @default(false) @map("acepto_aviso_privacidad")
  fechaAceptacionAviso   DateTime?        @map("fecha_aceptacion_aviso") @db.Timestamptz
  versionAvisoAceptado   Int?             @map("version_aviso_aceptado")

  miembroOrg             OrgMiembro[]
  membresiasCoto         MiembroCoto[]
  paymentMethods         PaymentMethod[]
  comentariosTicket      TicketComentario[]
  ticketsReportados      Ticket[]         @relation("TicketReportador")
  reservaciones          Reservacion[]
  invitacionesCreadas    InvitacionAcceso[]
  registrosComoGuardia   RegistroAcceso[]
  staffPlataforma        StaffPlataforma?
  soporteOtorgado        SoporteAcceso[]

  activo                 Boolean          @default(true)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([telefono])
  @@map("usuarios")
}

model MiembroCoto {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId         String    @map("coto_id") @db.Uuid
  unidadId       String?   @map("unidad_id") @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  rol            String    @db.VarChar(30) // coto_admin, coto_tesorero, coto_comite, residente_propietario, residente_inquilino, guardia, proveedor
  vehiculos      Json?     @default("[]")
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coto           Coto      @relation(fields: [cotoId], references: [id], onDelete: Cascade)
  unidad         Unidad?   @relation(fields: [unidadId], references: [id], onDelete: SetNull)
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  votos          Voto[]

  @@unique([cotoId, usuarioId, rol, unidadId]) // una persona puede ser dueña de varias unidades del mismo coto
  @@index([cotoId, unidadId, rol])
  @@index([usuarioId, activo]) // usado por las funciones de RLS en cada consulta
  @@map("miembros_coto")
}

// ──────────────────────────────────────────────────────────────────────
// NIVEL 4: FINANZAS, PAGOS Y AUTO-PAY
// ──────────────────────────────────────────────────────────────────────

model ConceptoCargo {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId        String   @map("coto_id") @db.Uuid
  nombre        String   @db.VarChar(100)
  tipo          String   @db.VarChar(20) // ordinario, extraordinario, multa, cuota_especial, reserva
  montoDefault  Decimal? @map("monto_default") @db.Decimal(12, 2)
  usaIndiviso   Boolean  @default(false) @map("usa_indiviso")
  esRecurrente  Boolean  @default(true) @map("es_recurrente")
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  coto          Coto     @relation(fields: [cotoId], references: [id], onDelete: Cascade)
  cargos        Cargo[]

  @@unique([cotoId, nombre])
  @@map("conceptos_cargo")
}

model Cargo {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId            String         @map("coto_id") @db.Uuid
  unidadId          String         @map("unidad_id") @db.Uuid
  conceptoId        String         @map("concepto_id") @db.Uuid
  periodo           String         @db.VarChar(7) // "2026-11"
  montoOriginal     Decimal        @map("monto_original") @db.Decimal(12, 2)
  montoMoratoria    Decimal        @default(0.00) @map("monto_moratoria") @db.Decimal(12, 2)
  montoDescuento    Decimal        @default(0.00) @map("monto_descuento") @db.Decimal(12, 2)
  saldoPendiente    Decimal        @map("saldo_pendiente") @db.Decimal(12, 2)
  estado            String         @default("pendiente") @db.VarChar(20) // pendiente, parcial, pagado, condonado, cancelado
  fechaEmision      DateTime       @default(now()) @map("fecha_emision") @db.Date
  fechaVencimiento  DateTime       @map("fecha_vencimiento") @db.Date
  /// Evita cargos duplicados (generación masiva repetida, reintentos de API).
  claveIdempotencia String?        @unique @map("clave_idempotencia") @db.VarChar(100)
  notas             String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coto              Coto           @relation(fields: [cotoId], references: [id])
  unidad            Unidad         @relation(fields: [unidadId], references: [id])
  concepto          ConceptoCargo  @relation(fields: [conceptoId], references: [id])
  detallePagos      DetallePago[]
  autopayIntentos   AutopayIntento[]

  @@index([cotoId, periodo])
  @@index([cotoId, estado, fechaVencimiento]) // morosidad / dashboard
  @@index([unidadId, estado, fechaVencimiento]) // estado de cuenta del residente
  @@map("cargos")
}

model Pago {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId             String        @map("coto_id") @db.Uuid
  unidadId           String        @map("unidad_id") @db.Uuid
  monto              Decimal       @db.Decimal(12, 2)
  metodo             String        @db.VarChar(30)
  gateway            String?       @db.VarChar(20) // conekta, stripe, manual
  gatewayOrderId     String?       @unique @map("gateway_order_id") @db.VarChar(100)
  gatewayChargeId    String?       @unique @map("gateway_charge_id") @db.VarChar(100)
  comprobanteUrl     String?       @map("comprobante_url") // llave de objeto privado, nunca URL pública
  referenciaBancaria String?       @map("referencia_bancaria") @db.VarChar(50)
  estado             String        @default("pendiente") @db.VarChar(20) // pendiente, en_revision, confirmado, rechazado, reembolsado
  fechaPago          DateTime      @default(now()) @map("fecha_pago") @db.Timestamptz
  fechaConfirmacion  DateTime?     @map("fecha_confirmacion") @db.Timestamptz
  /// Marca de aplicación a cargos (app.aplicar_pago es idempotente gracias a esto).
  aplicadoEn         DateTime?     @map("aplicado_en") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coto               Coto          @relation(fields: [cotoId], references: [id])
  unidad             Unidad        @relation(fields: [unidadId], references: [id])
  detallePagos       DetallePago[]
  facturaCfdi        FacturaCfdi?
  autopayIntentos    AutopayIntento[]

  @@index([cotoId, estado, fechaPago])
  @@index([unidadId, fechaPago])
  @@map("pagos")
}

model DetallePago {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId         String   @map("coto_id") @db.Uuid
  pagoId         String   @map("pago_id") @db.Uuid
  cargoId        String   @map("cargo_id") @db.Uuid
  montoAplicado  Decimal  @map("monto_aplicado") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  coto           Coto     @relation(fields: [cotoId], references: [id])
  pago           Pago     @relation(fields: [pagoId], references: [id])
  cargo          Cargo    @relation(fields: [cargoId], references: [id])

  @@unique([pagoId, cargoId])
  @@index([cargoId])
  @@map("detalle_pagos")
}

model PaymentMethod {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId            String          @map("coto_id") @db.Uuid
  unidadId          String          @map("unidad_id") @db.Uuid
  usuarioId         String          @map("usuario_id") @db.Uuid
  tipo              String          @db.VarChar(20) // card, clabe, spei_mandate
  gateway           String          @default("conekta") @db.VarChar(20)
  gatewayCustomerId String          @map("gateway_customer_id") @db.VarChar(100)
  gatewaySourceId   String?         @map("gateway_source_id") @db.VarChar(100)
  label             String?         @db.VarChar(100)
  ultimos4          String?         @map("ultimos_4") @db.Char(4)
  marcaTarjeta      String?         @map("marca_tarjeta") @db.VarChar(20)
  fechaExpiracion   String?         @map("fecha_expiracion") @db.VarChar(7)
  esDefault         Boolean         @default(false) @map("es_default")
  activo            Boolean         @default(true)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  coto              Coto            @relation(fields: [cotoId], references: [id])
  unidad            Unidad          @relation(fields: [unidadId], references: [id])
  usuario           Usuario         @relation(fields: [usuarioId], references: [id])
  autopayConfigs    AutopayConfig[]

  @@index([unidadId, activo])
  @@index([usuarioId])
  @@map("payment_methods")
}

model AutopayConfig {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId               String           @map("coto_id") @db.Uuid
  unidadId             String           @unique @map("unidad_id") @db.Uuid
  paymentMethodId      String?          @map("payment_method_id") @db.Uuid
  activo               Boolean          @default(false)
  diaCobro             Int              @default(5) @map("dia_cobro") @db.SmallInt
  maxReintentos        Int              @default(3) @map("max_reintentos") @db.SmallInt
  diasEntreReintentos  Int[]            @default([3, 7, 14]) @map("dias_entre_reintentos")
  intentosFallidos     Int              @default(0) @map("intentos_fallidos") @db.SmallInt
  ultimoCobroExitoso   DateTime?        @map("ultimo_cobro_exitoso") @db.Date
  proximoCobro         DateTime?        @map("proximo_cobro") @db.Date
  estado               String           @default("activo") @db.VarChar(25) // activo, pausado, suspendido_por_fallos, cancelado_por_usuario
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coto                 Coto             @relation(fields: [cotoId], references: [id])
  unidad               Unidad           @relation(fields: [unidadId], references: [id])
  paymentMethod        PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  intentos             AutopayIntento[]

  @@index([estado, proximoCobro]) // scheduler de cobros
  @@map("autopay_config")
}

model AutopayIntento {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  autopayId      String        @map("autopay_id") @db.Uuid
  cotoId         String        @map("coto_id") @db.Uuid
  cargoId        String?       @map("cargo_id") @db.Uuid
  pagoId         String?       @map("pago_id") @db.Uuid
  intentoNum     Int           @map("intento_num") @db.SmallInt
  montoCentavos  Int           @map("monto_centavos")
  gateway        String        @db.VarChar(20)
  gatewayOrderId String?       @map("gateway_order_id") @db.VarChar(100)
  estado         String        @db.VarChar(20) // pendiente, exitoso, fallido, reembolsado
  codigoError    String?       @map("codigo_error") @db.VarChar(50)
  mensajeError   String?       @map("mensaje_error")
  programadoPara DateTime      @map("programado_para") @db.Timestamptz
  ejecutadoEn    DateTime?     @map("ejecutado_en") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  autopay        AutopayConfig @relation(fields: [autopayId], references: [id])
  coto           Coto          @relation(fields: [cotoId], references: [id])
  cargo          Cargo?        @relation(fields: [cargoId], references: [id])
  pago           Pago?         @relation(fields: [pagoId], references: [id])

  /// Un reintento del scheduler nunca cobra dos veces el mismo intento.
  @@unique([autopayId, cargoId, intentoNum])
  @@index([programadoPara, estado])
  @@map("autopay_intentos")
}

model FacturaCfdi {
