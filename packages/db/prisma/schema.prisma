model InvitacionAcceso {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId         String    @map("coto_id") @db.Uuid
  unidadId       String    @map("unidad_id") @db.Uuid
  creadoPor      String    @map("creado_por") @db.Uuid
  nombreInvitado String    @map("nombre_invitado") @db.VarChar(200)
  tipo           String    @db.VarChar(30) // unico, temporal, frecuente, evento, proveedor, paqueteria
  /// SHA-256 (hex) del token del QR. El token en claro solo viaja al residente.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  codigoNumerico String?   @map("codigo_numerico") @db.Char(6)
  validoDesde    DateTime  @default(now()) @map("valido_desde") @db.Timestamptz
  validoHasta    DateTime? @map("valido_hasta") @db.Timestamptz
  maxUsos        Int?      @default(1) @map("max_usos") // NULL = ilimitado
  usosActuales   Int       @default(0) @map("usos_actuales")
  estado         String    @default("activo") @db.VarChar(20) // activo, usado, expirado, revocado
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  coto      Coto             @relation(fields: [cotoId], references: [id])
  unidad    Unidad           @relation(fields: [unidadId], references: [id])
  creador   Usuario          @relation(fields: [creadoPor], references: [id])
  registros RegistroAcceso[]

  @@index([cotoId, estado, validoHasta])
  @@index([cotoId, codigoNumerico])
  @@index([unidadId, estado])
  @@map("invitaciones_acceso")
}

