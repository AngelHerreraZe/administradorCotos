// ──────────────────────────────────────────────────────────────────────
// NIVEL 5: ACCESOS, IOT, AMENIDADES, COMUNICACIÓN Y AUDITORÍA
// ──────────────────────────────────────────────────────────────────────

model InvitacionAcceso {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId         String           @map("coto_id") @db.Uuid
  unidadId       String           @map("unidad_id") @db.Uuid
  creadoPor      String           @map("creado_por") @db.Uuid
  nombreInvitado String           @map("nombre_invitado") @db.VarChar(200)
  tipo           String           @db.VarChar(30) // unico, temporal, frecuente, evento, proveedor, paqueteria
  /// SHA-256 (hex) del token del QR. El token en claro solo viaja al residente.
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  codigoNumerico String?          @map("codigo_numerico") @db.Char(6)
  validoDesde    DateTime         @default(now()) @map("valido_desde") @db.Timestamptz
  validoHasta    DateTime?        @map("valido_hasta") @db.Timestamptz
  maxUsos        Int?             @default(1) @map("max_usos") // NULL = ilimitado
  usosActuales   Int              @default(0) @map("usos_actuales")
  estado         String           @default("activo") @db.VarChar(20) // activo, usado, expirado, revocado
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  coto           Coto             @relation(fields: [cotoId], references: [id])
  unidad         Unidad           @relation(fields: [unidadId], references: [id])
  creador        Usuario          @relation(fields: [creadoPor], references: [id])
  registros      RegistroAcceso[]

  @@index([cotoId, estado, validoHasta])
  @@index([cotoId, codigoNumerico])
  @@index([unidadId, estado])
  @@map("invitaciones_acceso")
}

model RegistroAcceso {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId         String            @map("coto_id") @db.Uuid
  invitacionId   String?           @map("invitacion_id") @db.Uuid
  unidadDestino  String?           @map("unidad_destino") @db.Uuid
  guardiaId      String?           @map("guardia_id") @db.Uuid
  tipoPersona    String            @map("tipo_persona") @db.VarChar(20)
  nombre         String?           @db.VarChar(200)
  placa          String?           @db.VarChar(15)
  metodo         String?           @db.VarChar(20) // qr, codigo, rfid, lpr, manual
  tipoMovimiento String            @default("entrada") @map("tipo_movimiento") @db.VarChar(10)
  autorizado     Boolean
  fechaHora      DateTime          @default(now()) @map("fecha_hora") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  coto           Coto              @relation(fields: [cotoId], references: [id])
  invitacion     InvitacionAcceso? @relation(fields: [invitacionId], references: [id])
  unidad         Unidad?           @relation(fields: [unidadDestino], references: [id])
  guardia        Usuario?          @relation(fields: [guardiaId], references: [id])

  @@index([cotoId, fechaHora])
  @@index([unidadDestino, fechaHora])
  @@map("registros_acceso")
}

model DispositivoIot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId          String   @map("coto_id") @db.Uuid
  nombre          String   @db.VarChar(100)
  tipo            String   @db.VarChar(30) // lector_qr, antena_rfid, camara_lpr, pluma_vehicular
  macAddress      String?  @map("mac_address") @db.VarChar(17)
  /// SHA-256 de la API key del dispositivo: se emite una vez, nunca se descifra.
  apiKeyHash      String?  @unique @map("api_key_hash") @db.Char(64)
  estado          String   @default("activo") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  coto            Coto     @relation(fields: [cotoId], references: [id], onDelete: Cascade)

  @@index([cotoId])
  @@map("dispositivos_iot")
}

model Amenidad {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId         String        @map("coto_id") @db.Uuid
  nombre         String        @db.VarChar(100)
  tipo           String?       @db.VarChar(30)
  capacidadMax   Int?          @map("capacidad_max")
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  coto           Coto          @relation(fields: [cotoId], references: [id], onDelete: Cascade)
  reservaciones  Reservacion[]

  @@index([cotoId])
  @@map("amenidades")
}

model Reservacion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId      String   @map("coto_id") @db.Uuid
  amenidadId  String   @map("amenidad_id") @db.Uuid
  unidadId    String   @map("unidad_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  fecha       DateTime @db.Date
  horaInicio  DateTime @map("hora_inicio") @db.Time
  horaFin     DateTime @map("hora_fin") @db.Time
  estado      String   @default("confirmada") @db.VarChar(20) // pendiente, confirmada, cancelada, completada, no_show
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  coto        Coto     @relation(fields: [cotoId], references: [id])
  amenidad    Amenidad @relation(fields: [amenidadId], references: [id])
  unidad      Unidad   @relation(fields: [unidadId], references: [id])
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([amenidadId, fecha, horaInicio])
  @@index([unidadId, fecha])
  @@map("reservaciones")
}

model Comunicado {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId      String   @map("coto_id") @db.Uuid
  titulo      String   @db.VarChar(200)
  cuerpo      String
  prioridad   String   @default("normal") @db.VarChar(10)
  publicado   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  coto        Coto     @relation(fields: [cotoId], references: [id])

  @@index([cotoId, publicado, createdAt])
  @@map("comunicados")
}

model Ticket {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId       String             @map("coto_id") @db.Uuid
  unidadId     String?            @map("unidad_id") @db.Uuid
  reportadoPor String             @map("reportado_por") @db.Uuid
  numero       Int                @default(autoincrement()) // ponytail: secuencia global (revela volumen); contador por coto si molesta
  titulo       String             @db.VarChar(200)
  descripcion  String
  categoria    String?            @db.VarChar(30)
  estado       String             @default("abierto") @db.VarChar(20)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  coto         Coto               @relation(fields: [cotoId], references: [id])
  unidad       Unidad?            @relation(fields: [unidadId], references: [id])
  reportador   Usuario            @relation("TicketReportador", fields: [reportadoPor], references: [id])
  comentarios  TicketComentario[]

  @@index([cotoId, estado, createdAt])
  @@index([reportadoPor])
  @@map("tickets")
}

model TicketComentario {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId     String   @map("coto_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  usuarioId  String   @map("usuario_id") @db.Uuid
  comentario String
  esInterno  Boolean  @default(false) @map("es_interno") // solo staff lo ve
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  coto       Coto     @relation(fields: [cotoId], references: [id])
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_comentarios")
}

model Votacion {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId               String       @map("coto_id") @db.Uuid
  titulo               String       @db.VarChar(200)
  ponderadaPorIndiviso Boolean      @default(false) @map("ponderada_por_indiviso")
  fechaInicio          DateTime     @map("fecha_inicio") @db.Timestamptz
  fechaFin             DateTime     @map("fecha_fin") @db.Timestamptz
  estado               String       @default("borrador") @db.VarChar(20) // borrador, activa, cerrada, cancelada
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz

  coto                 Coto         @relation(fields: [cotoId], references: [id])
  opciones             OpcionVoto[]
  votos                Voto[]

  @@index([cotoId, estado])
  @@map("votaciones")
}

model OpcionVoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotoId      String   @map("coto_id") @db.Uuid
  votacionId  String   @map("votacion_id") @db.Uuid
  texto       String   @db.VarChar(300)

  coto        Coto     @relation(fields: [cotoId], references: [id])
  votacion    Votacion @relation(fields: [votacionId], references: [id], onDelete: Cascade)
  votos       Voto[]

  @@index([votacionId])
  @@map("opciones_voto")
}

/// Inmutable. Se emite solo vía app.votar(); un voto por unidad.
model Voto {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  votacionId String      @map("votacion_id") @db.Uuid
  cotoId     String      @map("coto_id") @db.Uuid
  opcionId   String      @map("opcion_id") @db.Uuid
  miembroId  String      @map("miembro_id") @db.Uuid
  unidadId   String      @map("unidad_id") @db.Uuid
  peso       Decimal     @default(1) @db.Decimal(10, 6)
  emitidoEn  DateTime    @default(now()) @map("emitido_en") @db.Timestamptz

  coto       Coto        @relation(fields: [cotoId], references: [id])
  votacion   Votacion    @relation(fields: [votacionId], references: [id])
  opcion     OpcionVoto  @relation(fields: [opcionId], references: [id])
  miembro    MiembroCoto @relation(fields: [miembroId], references: [id])
  unidad     Unidad      @relation(fields: [unidadId], references: [id])

  @@unique([votacionId, unidadId])
  @@index([opcionId])
  @@map("votos")
}

// ──────────────────────────────────────────────────────────────────────
// AUDITORÍA FORENSE INMUTABLE (OUTBOX → CADENA HMAC POR ORGANIZACIÓN)
// Triggers escriben en audit_outbox dentro de la misma transacción del
// cambio; un worker único encadena (HMAC) hacia audit_log. Sin FKs: el
// log sobrevive a cualquier borrado y nunca bloquea derechos ARCO.
// ──────────────────────────────────────────────────────────────────────

model AuditOutbox {
  id           BigInt   @id @default(autoincrement())
  orgId        String   @map("org_id") @db.Uuid
  cotoId       String?  @map("coto_id") @db.Uuid
  usuarioId    String?  @map("usuario_id") @db.Uuid
  accion       String   @db.VarChar(60)
  recursoTipo  String   @map("recurso_tipo") @db.VarChar(50)
  recursoId    String?  @map("recurso_id") @db.Uuid
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_outbox")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  orgId          String   @map("org_id") @db.Uuid
  cotoId         String?  @map("coto_id") @db.Uuid
  usuarioId      String?  @map("usuario_id") @db.Uuid // NULL = sistema/worker
  accion         String   @db.VarChar(60) // ej. "pagos.update"
  recursoTipo    String   @map("recurso_tipo") @db.VarChar(50)
  recursoId      String?  @map("recurso_id") @db.Uuid
  datosAntes     Json?    @map("datos_antes")
  datosDespues   Json?    @map("datos_despues")
  metadata       Json?    // rol de BD, request id, IP
  hashAnterior   String   @map("hash_anterior") @db.Char(64)
  hashIntegridad String   @map("hash_integridad") @db.Char(64)
  createdAt      DateTime @map("created_at") @db.Timestamptz

  @@index([orgId, createdAt(sort: Desc)])
  @@index([cotoId, createdAt(sort: Desc)])
  @@index([usuarioId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model AuditChainHead {
  orgId      String   @id @map("org_id") @db.Uuid
  ultimoHash String   @map("ultimo_hash") @db.Char(64)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("audit_chain_head")
}
