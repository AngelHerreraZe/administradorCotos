  claveIdempotencia  String?   @unique @map("clave_idempotencia") @db.VarChar(100)
  estado             String    @default("pendiente") @db.VarChar(20) // pendiente, en_revision, confirmado, rechazado, reembolsado
  motivoRechazo      String?   @map("motivo_rechazo")
