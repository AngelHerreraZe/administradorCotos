  diaCobro            Int       @default(5) @map("dia_cobro") @db.SmallInt
  maxReintentos       Int       @default(3) @map("max_reintentos") @db.SmallInt
  diasEntreReintentos Int[]     @default([3, 7, 14]) @map("dias_entre_reintentos")
  intentosFallidos    Int       @default(0) @map("intentos_fallidos") @db.SmallInt
  ultimoCobroExitoso  DateTime? @map("ultimo_cobro_exitoso") @db.Date
  proximoCobro        DateTime? @map("proximo_cobro") @db.Date
  estado              String    @default("activo") @db.VarChar(25) // activo, pausado, suspendido_por_fallos, cancelado_por_usuario
  terminosVersion     String?   @map("terminos_version") @db.VarChar(30)
