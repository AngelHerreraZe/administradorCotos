{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".node-version"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"],
      "outputs": ["coverage/**"]
    },
    "test:security": {
      "dependsOn": ["generate", "^generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["generate", "^generate"],
      "cache": false,
      "persistent": true
    }
  }
}
