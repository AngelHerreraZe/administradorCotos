{
  "name": "@admcotos/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import ./src/instrument.ts src/main.ts | pino-pretty",
    "start": "node --import ./src/instrument.ts src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run --exclude test/e2e/**",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@admcotos/db": "*",
    "@admcotos/security": "*",
    "@admcotos/shared": "*",
    "@hono/node-server": "2.1.11",
    "@hono/zod-openapi": "1.6.3",
    "@sentry/node": "11.19.0",
    "bullmq": "6.7.10",
    "csv-parse": "7.0.3",
    "hono": "4.13.22",
    "ioredis": "6.1.0",
    "jose": "6.2.18",
    "pino": "10.4.0",
    "rate-limiter-flexible": "11.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "pino-pretty": "13.2.0"
  }
}
