{
  "name": "administradorcotos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma SaaS Multi-Tenant para Administración de Condominios y Cotos (B2B Mayoreo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:security": "turbo run test:security",
    "check": "biome ci . && turbo run typecheck test",
    "db:generate": "npm run generate -w @admcotos/db",
    "db:migrate:dev": "npm run migrate:dev -w @admcotos/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @admcotos/db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "26.6.11",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "npm@12.2.3"
}
